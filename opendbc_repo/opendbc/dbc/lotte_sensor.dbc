CM_ BU_ Xsens_IMU "Xsens MTi-630R IMU sensor (IMU only, no GNSS)";
CM_ BU_ RPi_GPS "Raspberry Pi CAN bridge for UM982 dual-antenna RTK GPS + VRS";
CM_ BU_ Autoware "Autoware upper-level controller commands";
CM_ BO_ 17 "Xsens status word with self-test and orientation validity";
CM_ BO_ 34 "Euler angles from Xsens AHRS filter";
CM_ BO_ 50 "Angular rate of turn from Xsens gyroscope";
CM_ BO_ 52 "Acceleration including gravity from Xsens accelerometer";
CM_ BO_ 53 "Free acceleration (gravity-compensated) from Xsens";
CM_ BO_ 256 "Primary antenna (Antenna 1) position from UM982";
CM_ BO_ 257 "Secondary antenna (Antenna 2) position from UM982";
CM_ BO_ 258 "Dual-antenna heading, ground speed, altitude and fix info";
CM_ BO_ 259 "Position accuracy estimates from UM982";
CM_ BO_ 260 "Dual-antenna pitch angle from UM982";
CM_ BO_ 261 "VRS NTRIP correction status from Raspberry Pi";
CM_ BO_ 512 "Target acceleration and steering angle from Autoware";

VAL_ 17 SelfTestOk 0 "false" 1 "true" ;
VAL_ 17 OrientationValid 0 "false" 1 "true" ;
VAL_ 258 fixType 0 "none" 2 "3D" 4 "RTK_float" 5 "RTK_fixed" ;

